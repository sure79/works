# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 비밀키가 들어가므로 git에 올라가지 않습니다(.gitignore).

# ── 1. LLM (둘 중 하나만 채우면 됨) ─────────────────────────
# (A) Anthropic 직접: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# (B) OpenRouter (여러 모델, 저렴한 모델 선택 가능): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── 2. 텔레그램 ───────────────────────────────────────────
# 텔레그램에서 @BotFather → /newbot → 발급된 토큰
TELEGRAM_BOT_TOKEN=
# 텔레그램에서 @userinfobot 에게 아무 메시지 → 숫자 ID
TELEGRAM_ALLOWED_USERS=
# 브리핑을 받을 채팅 ID (개인 DM이면 위 사용자 ID와 같은 값)
TELEGRAM_HOME_CHANNEL=

# ── 3. 시간대 (cron 시간이 이 기준으로 동작) ───────────────
HERMES_TIMEZONE=Asia/Seoul

# ── 4. 브리핑 시각 (cron 형식: 분 시 일 월 요일) ─────────────
# 매일 07:00 → "0 7 * * *",  평일만 06:30 → "30 6 * * 1-5"
BRIEFING_CRON="0 7 * * *"
# (선택) 모델 변경. 비워두면 Claude Sonnet 4.6 사용
# BRIEFING_MODEL=

# ── 5. (선택) 웹검색 키 — 없으면 무료 keyless 검색을 사용 ──
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
